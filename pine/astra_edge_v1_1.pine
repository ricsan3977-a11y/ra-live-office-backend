//@version=6
// =============================================================================
//  R&A ASTRA Edge v1.1 — TradingView dynamic alert() emitter (Pine Script v6)
//  CORRECTED REV B — 2026-10-12
// =============================================================================
//  Contract : astra-edge-event-v1.1 (30 canonical keys, ASCII-sorted)
//  Strategy : STRATEGY2_ASTRA_EDGE_V1 · version 1.0.2
//  Mode     : SHADOW ONLY · order_permission = false
//
//  REV B CORRECTIONS (Ric's code review, 2026-10-12):
//  1. Footprint API was wrong. Correct v6 API:
//       footprint fp = request.footprint(ticks_per_row, va_percent,
//                                        imbalance_percent = n)
//     returns a `footprint` object for the CURRENT chart bar (no ticker /
//     timeframe args), or na when unavailable (Premium/Ultimate required).
//     Readings via fp.buy_volume() / fp.sell_volume() / fp.delta(), and
//     stacked imbalance rows by iterating fp.rows() (array<volume_row>)
//     counting CONSECUTIVE rows with has_buy_imbalance()/has_sell_imbalance().
//     The old tuple-destructure form never existed and could not compile.
//     (Note: v1.0's pine had the same uncorrected call and was never
//     compiler-verified.)
//  2. f_reset_setup() assigned to globals from inside a function — illegal in
//     Pine (functions cannot modify globals). Resets are now inlined at
//     global scope, the only place := on globals is legal.
//  3. Working locals renamed with w_ prefix so they cannot shadow any
//     contract global; contract globals keep g_ prefix exclusively.
//
//  WHAT THIS DOES
//  Emits ONE dynamic alert() JSON per confirmed signal bar, carrying the actual
//  footprint/delta readings. The receiving edge validates, canonicalizes, and
//  HMAC-signs off-chart — Pine never sees a secret, never sends payload_hash,
//  and never assigns strategy_run_id (null on the wire, ruling 5).
//
//  NO-REPAINT CONTRACT
//  Every state transition is evaluated ONLY on confirmed bars
//  (barstate.isconfirmed). Multi-timeframe reads use lookahead_off.
//  Intrabar values may plot as PROV and can never trigger an alert.
//
//  FROZEN GATES (inputs can raise, never lower)
//  score >= 72 · directional gap >= 15 · room >= 1.8R · freshness <= 8 bars ·
//  2-row stacked imbalance. 15M context is a score input, NEVER a veto.
//
//  COMPILE CHECK (required — only TradingView can do this)
//  Paste into the Pine Editor on the NQZ2026 1-minute chart, "Add to chart".
//  If the compiler reports errors, paste them back verbatim for correction.
//  Then: create alert → "alert() function calls only" → webhook URL
//  https://ra-live-office-backend.onrender.com/ingest/tv?token=<token>
//  (token value is NOT in this script) → fire TEST_PING first.
//
//  Connectivity test vs profitability proof: this emitter proves ONE genuine
//  alert traverses footprint -> JSON -> webhook -> lifecycle -> audit.
//  It says nothing about strategy profitability — that is the counted shadow
//  sample's job, separate and later.
// =============================================================================

indicator("R&A ASTRA Edge v1.1 emitter", overlay=true)

// ════════════════════════════ INPUTS ════════════════════════════════════════
// No secret input. No run-id input. Both are assigned off-chart.

inScoreMin = input.int(72, "Score threshold (B+)",
     minval=72, group="Gates",
     tooltip="Locked floor 72. Can be raised, never lowered.")
inGapMin   = input.int(15, "Directional gap",
     minval=15, group="Gates",
     tooltip="Locked floor 15. Can be raised, never lowered.")
inRoomMin  = input.float(1.8, "Min room to target (R)",
     minval=1.8, step=0.1, group="Gates",
     tooltip="Locked floor 1.8R. Can be raised, never lowered.")
inFresh    = input.int(8, "Freshness window (bars)",
     minval=1, maxval=8, group="Gates",
     tooltip="Sweep evidence expires after this many 1M bars. Contract max 8.")
inTicksPerRow = input.int(100, "Footprint ticks per row",
     minval=1, group="Footprint",
     tooltip="Price granularity of each footprint row, in ticks.")
inVAPct = input.int(70, "Footprint Value Area %",
     minval=1, maxval=100, group="Footprint")
inImbPct = input.int(300, "Footprint imbalance %",
     minval=100, group="Footprint",
     tooltip="Row imbalance detection threshold. 300 = 3x opposing volume.")
inContract = input.string("", "Contract override (blank = chart symbol)",
     group="Symbol")
inTestPing = input.bool(false, "Send TEST_PING on next bar close (one-shot)",
     group="Diagnostics",
     tooltip="Fires one TEST_PING event to verify the webhook path, then latches off.")

scoreFloor = math.max(inScoreMin, 72)
gapFloor   = math.max(inGapMin, 15)
roomFloor  = math.max(inRoomMin, 1.8)

// Frozen (non-input) constants.
STACK_ROWS_MIN = 2        // 2-row stacked imbalance (frozen)
W_SWEEP  = 25             // evidence weights, long/short symmetric, sum = 100
W_ABSORB = 15
W_STACK  = 10
W_RECLAIM = 15
W_FLOW   = 20
W_CTX15  = 15             // 15M context: score input only, NOT a veto

STRAT_ID  = "STRATEGY2_ASTRA_EDGE_V1"
STRAT_VER = "1.0.2"
SCHEMA_V  = "astra-edge-event-v1.1"

// ═══════════════════ CONTRACT FIELD GLOBALS (per emitted event) ════════════
// g_ prefix is reserved for these. No other variable may use it.

string g_event_type = ""
string g_event_id   = ""
string g_symbol     = ""
string g_contract   = ""
string g_direction  = "NONE"
int    g_market_ts  = 0
int    g_observed   = 0
string g_setup_id   = ""
string g_liq_type   = "NONE"
float  g_liq_price  = na
bool   g_sweep_conf = false
string g_absorption = "NONE"
string g_flow       = "NEUTRAL"
int    g_long       = 0
int    g_short      = 0
int    g_gap        = 0
string g_reclaim    = "NONE"
float  g_room_r     = na
string g_target_ref = "NONE"
bool   g_armed      = false
string g_release_state = "PENDING"
bool   g_fp_ok      = false
int    g_fresh_bars = 0
int    g_stack_rows = 0

// ════════════════════════ CANONICAL JSON BUILDER ═══════════════════════════
// ASCII-sorted keys, compact separators. payload_hash is NEVER emitted by
// Pine — the edge computes it after validation. strategy_run_id is null on
// the wire (ruling 5: locally assigned; null or omitted only).

f_jstr(s)  => "\"" + s + "\""
f_jbool(b) => b ? "true" : "false"
f_jint(x)  => str.tostring(int(x))

// Number with exactly 2 decimals, or null for na. Matches the receiver's
// canonicalizer bit-for-bit (abs*100, round half away from zero).
f_jnum2(x) =>
    string out = "null"
    if not na(x)
        float ax = math.abs(x)
        int r = int(math.round(ax * 100))
        int cents = r % 100
        out := (x < 0 ? "-" : "") + str.tostring(int(r / 100)) + "." + (cents < 10 ? "0" + str.tostring(cents) : str.tostring(cents))
    out

f_canon_json() =>
    "{\"absorption_state\":"     + f_jstr(g_absorption)   + "," +
     "\"armed\":"                + f_jbool(g_armed)       + "," +
     "\"chart_timeframe\":"      + f_jstr(timeframe.period) + "," +
     "\"contract\":"             + f_jstr(g_contract)     + "," +
     "\"direction\":"            + f_jstr(g_direction)    + "," +
     "\"directional_gap\":"      + f_jint(g_gap)          + "," +
     "\"event_id\":"             + f_jstr(g_event_id)     + "," +
     "\"event_type\":"           + f_jstr(g_event_type)   + "," +
     "\"flow_state\":"           + f_jstr(g_flow)         + "," +
     "\"footprint_available\":"  + f_jbool(g_fp_ok)       + "," +
     "\"freshness_bars\":"       + f_jint(g_fresh_bars)   + "," +
     "\"liquidity_price\":"      + f_jnum2(g_liq_price)   + "," +
     "\"liquidity_type\":"       + f_jstr(g_liq_type)     + "," +
     "\"long_score\":"           + f_jint(g_long)         + "," +
     "\"market_ts\":"            + f_jint(g_market_ts)   + "," +
     "\"observed_at\":"          + f_jint(g_observed)     + "," +
     "\"reclaim_state\":"        + f_jstr(g_reclaim)      + "," +
     "\"release_state\":"        + f_jstr(g_release_state)+ "," +
     "\"room_r\":"               + f_jnum2(g_room_r)      + "," +
     "\"schema_version\":"       + f_jstr(SCHEMA_V)       + "," +
     "\"setup_id\":"             + f_jstr(g_setup_id)     + "," +
     "\"short_score\":"          + f_jint(g_short)        + "," +
     "\"source_bar_close\":1," +
     "\"stacked_imbalance_rows\":" + f_jint(g_stack_rows) + "," +
     "\"strategy_id\":"          + f_jstr(STRAT_ID)       + "," +
     "\"strategy_run_id\":null," +
     "\"strategy_version\":"     + f_jstr(STRAT_VER)      + "," +
     "\"sweep_confirmed\":"      + f_jbool(g_sweep_conf)  + "," +
     "\"symbol\":"               + f_jstr(g_symbol)       + "," +
     "\"target_reference\":"     + f_jstr(g_target_ref)   + "}"

// One alert per bar close, highest-priority signal wins.
f_emit_event() =>
    alert(f_canon_json(), alert.freq_once_per_bar_close)

// ════════════════════ MULTI-TIMEFRAME CONTEXT (15M) ═════════════════════════
// lookahead_off everywhere: no future leak, no repaint.

pdh    = request.security(syminfo.tickerid, "D",  high[1], lookahead=barmerge.lookahead_off)
pdl    = request.security(syminfo.tickerid, "D",  low[1],  lookahead=barmerge.lookahead_off)
sessHi = request.security(syminfo.tickerid, "15", ta.highest(high, 26), lookahead=barmerge.lookahead_off)
sessLo = request.security(syminfo.tickerid, "15", ta.lowest(low, 26),  lookahead=barmerge.lookahead_off)
ema15  = request.security(syminfo.tickerid, "15", ta.ema(close, 21),   lookahead=barmerge.lookahead_off)

// ════════════════════════ FOOTPRINT ADAPTER ═════════════════════════════════
// Correct v6 API: request.footprint(ticks_per_row, va_percent,
//                                  imbalance_percent = n)
// Returns a `footprint` object for the CURRENT chart bar, or na when
// unavailable (Premium/Ultimate required). Single call per script — Pine
// errors on multiple footprint requests in one context.
// Delta is NEVER synthesized from OHLC — missing footprint is reported via
// the DATA_UNAVAILABLE path, never faked.
footprint wFp = request.footprint(inTicksPerRow, inVAPct, imbalance_percent = inImbPct)
bool wFpOk = not na(wFp)

// Max run of CONSECUTIVE rows carrying the wanted imbalance side.
// rows() returns volume_row IDs ordered lowest row first.
f_max_stack(array<volume_row> rows, bool wantBuy) =>
    int best = 0
    int run = 0
    for row in rows
        bool imb = wantBuy ? row.has_buy_imbalance() : row.has_sell_imbalance()
        if imb
            run += 1
            if run > best
                best := run
        else
            run := 0
    best

// ════════════════════ SIGNAL STATE (confirmed bars only) ═══════════════════

var string stDir          = "NONE"    // "LONG" | "SHORT" | "NONE"
var float  stLevel        = na        // swept liquidity level
var string stLiqType      = "NONE"    // "PDL" | "PDH"
var int    stBar          = na
var int    stTime         = na
var string stAbsorb       = "NONE"    // "SELLERS ABSORBED" | "BUYERS ABSORBED" | "NONE"
var string stReclaim      = "NONE"    // "NONE" | "PENDING" | "CONFIRMED" | "FAILED"
var string stFlow         = "NEUTRAL" // "BULLISH_SHIFT" | "BEARISH_SHIFT" | "NEUTRAL"
var bool   stArmed        = false
var int    stArmedBar     = na
var bool   stReleased     = false
var string stReleaseState = "PENDING" // "PENDING" | "RELEASED"
var string stSetupId      = ""
var float  cumDelta       = 0.0       // footprint delta accumulated since sweep
var int    stStackRows    = 0         // max stacked imbalance rows seen (wire field)
var bool   pingDone       = false     // TEST_PING one-shot latch

// Global signal flags for plots (block-scoped vars can't be plotted).
sigSweepL  = false
sigSweepS  = false
sigReclaim = false
sigArmedB  = false
sigRelL    = false
sigRelS    = false

// ═══════════════════════ MAIN: CONFIRMED BARS ONLY ══════════════════════════
// NOTE: resets are inlined here (not in a function) because Pine forbids
// functions from modifying globals.

if barstate.isconfirmed
    atrV = ta.atr(14)

    // ---- per-bar working vars (w_ prefix; never g_) ----
    bool wNewSweepL  = false
    bool wNewSweepS  = false
    bool wNewAbsorb  = false
    bool wNewReclaim = false
    bool wNewFlow    = false
    bool wNewlyArmed = false
    bool wDoRelease  = false
    bool wTerminal   = false
    int  wLongScore  = 0
    int  wShortScore = 0
    int  wGap        = 0
    float wRoom      = na
    string wTgtRef   = "NONE"
    string wEvType   = ""
    string wRelDir   = "NONE"      // release direction, captured before reset

    string wPrevAbsorb  = stAbsorb
    string wPrevReclaim = stReclaim
    string wPrevFlow    = stFlow

    // ---- footprint readings for the just-closed bar ----
    float wDelta = na
    int   wRowsL = 0
    int   wRowsS = 0
    if wFpOk
        wDelta := wFp.delta()
        array<volume_row> wArr = wFp.rows()
        wRowsL := f_max_stack(wArr, true)
        wRowsS := f_max_stack(wArr, false)

    // ---- 1. liquidity sweep detection (wick through PDH/PDL) ----
    wNewSweepL := stDir == "NONE" and not na(pdl) and low < pdl
    wNewSweepS := stDir == "NONE" and not na(pdh) and high > pdh
    if wNewSweepL or wNewSweepS
        stDir          := wNewSweepL ? "LONG" : "SHORT"
        stLevel        := wNewSweepL ? pdl : pdh
        stLiqType      := wNewSweepL ? "PDL" : "PDH"
        stBar          := bar_index
        stTime         := int(time)
        stAbsorb       := "NONE"
        stReclaim      := "PENDING"
        stFlow         := "NEUTRAL"
        stArmed        := false
        stArmedBar     := na
        stReleased     := false
        stReleaseState := "PENDING"
        stSetupId      := "ASTRA-" + syminfo.ticker + "-" + stDir + "-" + str.tostring(stTime)
        cumDelta       := 0.0
        stStackRows    := 0

    // ---- 2..6 active setup pipeline ----
    if stDir != "NONE"
        bool wIsLong = stDir == "LONG"
        int wBarsSince = bar_index - stBar

        // footprint delta accumulation (confirmed bars only)
        if wFpOk
            cumDelta := cumDelta + wDelta
            int wRowsNow = wIsLong ? wRowsL : wRowsS
            if wRowsNow > stStackRows
                stStackRows := wRowsNow

        // 2. absorption: delta leans with the setup while the level holds
        if wFpOk and stAbsorb == "NONE"
            bool wHeldL = wIsLong  and low  >= stLevel - 0.10 * atrV
            bool wHeldS = not wIsLong and high <= stLevel + 0.10 * atrV
            if wIsLong and cumDelta > 0 and wHeldL
                stAbsorb := "SELLERS ABSORBED"
            if not wIsLong and cumDelta < 0 and wHeldS
                stAbsorb := "BUYERS ABSORBED"

        // 3. reclaim: close back through the swept level (close-confirmed)
        if wIsLong and close > stLevel
            stReclaim := "CONFIRMED"
        if not wIsLong and close < stLevel
            stReclaim := "CONFIRMED"
        // invalidation: level lost badly -> FAILED (terminal, silent reset)
        if (wIsLong and close < stLevel - 0.5 * atrV) or (not wIsLong and close > stLevel + 0.5 * atrV)
            stReclaim := "FAILED"

        // 4. flow shift: displacement = range expansion + strong directional close
        float wRng = high - low
        if wIsLong and wRng > 1.5 * atrV and close > open and close >= high - 0.25 * wRng
            stFlow := "BULLISH_SHIFT"
        if not wIsLong and wRng > 1.5 * atrV and close < open and close <= low + 0.25 * wRng
            stFlow := "BEARISH_SHIFT"

        // 5. evidence scores 0-100 (symmetric, sum of weights = 100)
        if wIsLong
            wLongScore := W_SWEEP
            wLongScore := wLongScore + (stAbsorb == "SELLERS ABSORBED" ? W_ABSORB : 0)
            wLongScore := wLongScore + (stStackRows >= STACK_ROWS_MIN ? W_STACK : 0)
            wLongScore := wLongScore + (stReclaim == "CONFIRMED" ? W_RECLAIM : 0)
            wLongScore := wLongScore + (stFlow == "BULLISH_SHIFT" ? W_FLOW : 0)
            // 15M context is a score input, NOT a veto:
            wLongScore := wLongScore + (not na(ema15) and close > ema15 ? W_CTX15 : 0)
        else
            wShortScore := W_SWEEP
            wShortScore := wShortScore + (stAbsorb == "BUYERS ABSORBED" ? W_ABSORB : 0)
            wShortScore := wShortScore + (stStackRows >= STACK_ROWS_MIN ? W_STACK : 0)
            wShortScore := wShortScore + (stReclaim == "CONFIRMED" ? W_RECLAIM : 0)
            wShortScore := wShortScore + (stFlow == "BEARISH_SHIFT" ? W_FLOW : 0)
            wShortScore := wShortScore + (not na(ema15) and close < ema15 ? W_CTX15 : 0)
        wGap := wLongScore >= wShortScore ? wLongScore - wShortScore : wShortScore - wLongScore

        // 6. clean target + 1.8R room check (nearest opposing liquidity)
        float wEntryP = close
        float wStopP  = na
        float wTgtP   = na
        if wIsLong
            wStopP := stLevel - 0.25 * atrV
            if not na(pdh) and pdh > wEntryP
                wTgtP   := pdh
                wTgtRef := "PDH"
            if not na(sessHi) and sessHi > wEntryP and (na(wTgtP) or sessHi < wTgtP)
                wTgtP   := sessHi
                wTgtRef := "SESSION_HIGH"
        else
            wStopP := stLevel + 0.25 * atrV
            if not na(pdl) and pdl < wEntryP
                wTgtP   := pdl
                wTgtRef := "PDL"
            if not na(sessLo) and sessLo < wEntryP and (na(wTgtP) or sessLo > wTgtP)
                wTgtP   := sessLo
                wTgtRef := "SESSION_LOW"
        float wRiskP = wIsLong ? wEntryP - wStopP : wStopP - wEntryP
        wRoom := not na(wTgtP) and wRiskP > 0 ? (wIsLong ? wTgtP - wEntryP : wEntryP - wTgtP) / wRiskP : na

        // ---- gates -> armed ----
        int  wScoreV     = wIsLong ? wLongScore : wShortScore
        bool wGateScore  = wScoreV >= scoreFloor
        bool wGateGap    = wGap >= gapFloor
        bool wGateRoom   = not na(wRoom) and wRoom >= roomFloor
        bool wGateFresh  = wBarsSince <= inFresh
        bool wGateRows   = stStackRows >= STACK_ROWS_MIN
        bool wGateAbsorb = stAbsorb == (wIsLong ? "SELLERS ABSORBED" : "BUYERS ABSORBED")
        bool wGateReclaim = stReclaim == "CONFIRMED"
        bool wGateFlow   = stFlow == (wIsLong ? "BULLISH_SHIFT" : "BEARISH_SHIFT")
        wNewlyArmed := wFpOk and not stArmed and wGateScore and wGateGap and wGateRoom and wGateFresh and wGateRows and wGateAbsorb and wGateReclaim and wGateFlow
        if wNewlyArmed
            stArmed    := true
            stArmedBar := bar_index

        // ---- release: first confirmed bar AFTER the armed bar ----
        // The armed decision is frozen at its bar close; later market behavior
        // never rewrites it (matches desk policy: judge the decision at the time).
        wDoRelease := stArmed and not stReleased and bar_index > stArmedBar
        if wDoRelease
            stReleased     := true
            stReleaseState := "RELEASED"

        // ---- transitions (for event priority) ----
        wNewAbsorb  := stAbsorb != "NONE" and wPrevAbsorb == "NONE"
        wNewReclaim := stReclaim == "CONFIRMED" and wPrevReclaim != "CONFIRMED"
        wNewFlow    := (stFlow == "BULLISH_SHIFT" or stFlow == "BEARISH_SHIFT") and wPrevFlow == "NEUTRAL"

        // ---- terminal: expired or failed -> silent reset (no resurrection) ----
        wTerminal := stReclaim == "FAILED" or (wBarsSince > inFresh and not stArmed)

    // ---- event selection: one alert per bar close, highest priority wins ----
    // TEST_PING works even with no active setup.
    if inTestPing and not pingDone
        wEvType := "TEST_PING"
    else if not wFpOk and (wNewSweepL or wNewSweepS)
        wEvType := "DATA_UNAVAILABLE"
    else if wDoRelease
        wEvType := "RELEASE"
    else if wNewlyArmed
        wEvType := "ARMED"
    else if wNewFlow
        wEvType := "FLOW_SHIFT"
    else if wNewReclaim
        wEvType := "RECLAIM_CONFIRMED"
    else if wNewAbsorb
        wEvType := "ABSORPTION_CONFIRMED"
    else if wNewSweepL or wNewSweepS
        wEvType := "SWEEP_DETECTED"

    // ---- populate the astra-edge-event-v1.1 contract ----
    if wEvType != ""
        bool wIsDU   = wEvType == "DATA_UNAVAILABLE"
        bool wIsPing = wEvType == "TEST_PING"
        int  wFreshV = stDir == "NONE" ? 0 : bar_index - stBar
        g_event_type    = wEvType
        g_event_id      = syminfo.ticker + "_" + str.tostring(int(time)) + "_" + wEvType
        g_symbol        = syminfo.ticker
        g_contract      = inContract == "" ? syminfo.ticker : inContract
        g_direction     = (wIsDU or wIsPing) ? "NONE" : stDir
        g_market_ts     = int(time)
        g_observed      = int(timenow)
        g_setup_id      = wIsPing ? "TEST-PING" : stSetupId
        g_liq_type      = wIsPing ? "NONE" : stLiqType
        g_liq_price     = wIsPing ? na : stLevel
        g_sweep_conf    = not wIsPing and stDir != "NONE"
        g_absorption    = wIsDU ? "DATA_UNAVAILABLE" : wIsPing ? "NONE" : stAbsorb
        g_flow          = wIsDU ? "DATA_UNAVAILABLE" : wIsPing ? "NEUTRAL" : stFlow
        g_long          = (wIsDU or wIsPing) ? 0 : wLongScore
        g_short         = (wIsDU or wIsPing) ? 0 : wShortScore
        g_gap           = (wIsDU or wIsPing) ? 0 : wGap
        g_reclaim       = wIsDU ? "DATA_UNAVAILABLE" : wIsPing ? "NONE" : stReclaim
        g_room_r        = (wIsDU or wIsPing) ? na : wRoom
        g_target_ref    = wTgtRef
        // armed=true is emitted ONLY with ARMED/RELEASE (relay coherence rule).
        g_armed         = wEvType == "ARMED" or wEvType == "RELEASE"
        g_release_state = stReleaseState
        g_fp_ok         = wFpOk
        g_fresh_bars    = wFreshV
        g_stack_rows    = stStackRows
        f_emit_event()
        if wIsPing
            pingDone := true
        if wDoRelease
            wRelDir := stDir     // capture before reset clears it
            // ---- inline reset (global scope only; see note above) ----
            stDir          := "NONE"
            stLevel        := na
            stLiqType      := "NONE"
            stBar          := na
            stTime         := na
            stAbsorb       := "NONE"
            stReclaim      := "NONE"
            stFlow         := "NEUTRAL"
            stArmed        := false
            stArmedBar     := na
            stReleased     := false
            stReleaseState := "PENDING"
            stSetupId      := ""
            cumDelta       := 0.0
            stStackRows    := 0
            // one-shot: a released setup never re-fires

    if wTerminal and not wDoRelease
        // ---- inline reset (global scope only; see note above) ----
        stDir          := "NONE"
        stLevel        := na
        stLiqType      := "NONE"
        stBar          := na
        stTime         := na
        stAbsorb       := "NONE"
        stReclaim      := "NONE"
        stFlow         := "NEUTRAL"
        stArmed        := false
        stArmedBar     := na
        stReleased     := false
        stReleaseState := "PENDING"
        stSetupId      := ""
        cumDelta       := 0.0
        stStackRows    := 0

    // ---- plot signal flags (global scope copies) ----
    sigSweepL  := wNewSweepL
    sigSweepS  := wNewSweepS
    sigReclaim := wNewReclaim
    sigArmedB  := wNewlyArmed
    sigRelL    := wDoRelease and wRelDir == "LONG"
    sigRelS    := wDoRelease and wRelDir == "SHORT"

// ════════════════════════════ PLOTS ══════════════════════════════════════════
// Confirmed markers fire only on confirmed bars. Intrabar "PROV" markers are
// explicitly provisional and never trigger alerts.

plot(pdh, "PDH", color=color.new(color.red, 40), style=plot.style_linebr)
plot(pdl, "PDL", color=color.new(color.green, 40), style=plot.style_linebr)

plotshape(sigSweepL, title="Sweep low (confirmed)", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.orange, 0), size=size.small, text="SWEEP")
plotshape(sigSweepS, title="Sweep high (confirmed)", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.orange, 0), size=size.small, text="SWEEP")
plotshape(sigReclaim, title="Reclaim confirmed", style=shape.diamond,
     location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny, text="RECLAIM")
plotshape(sigArmedB, title="Armed", style=shape.labelup,
     location=location.belowbar, color=color.new(color.purple, 0), size=size.small, text="ARMED")
plotshape(sigRelL, title="Release LONG", style=shape.labelup,
     location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="REL L")
plotshape(sigRelS, title="Release SHORT", style=shape.labeldown,
     location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="REL S")

// Provisional intrabar sweep hints — labeled PROV, never alert.
bool provL = not barstate.isconfirmed and stDir == "NONE" and not na(pdl) and low < pdl
bool provS = not barstate.isconfirmed and stDir == "NONE" and not na(pdh) and high > pdh
plotshape(provL, title="PROVISIONAL sweep low (intrabar, unconfirmed)", style=shape.circle,
     location=location.belowbar, color=color.new(color.gray, 0), size=size.tiny, text="PROV")
plotshape(provS, title="PROVISIONAL sweep high (intrabar, unconfirmed)", style=shape.circle,
     location=location.abovebar, color=color.new(color.gray, 0), size=size.tiny, text="PROV")
